rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Koleksi users - hanya bisa baca/tulis data sendiri
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Koleksi attendances - document id adalah id_attendance (tanpa field user_id)
    match /attendances/{id_attendance} {
      allow read, write: if request.auth != null;
    }

    // Koleksi leaves - document id adalah id_leave (tanpa field user_id)
    match /leaves/{id_leave} {
      allow read, write: if request.auth != null;
    }

    // Koleksi presensi (lama) - backward compat
    match /presensi/{docId} {
      allow read, write: if request.auth != null;
    }

    // Libur nasional - semua yang login bisa baca
    match /libur_nasional/{docId} {
      allow read: if request.auth != null;
    }
  }
}
